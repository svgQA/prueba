{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "&/*": ["src/pages/settings/*"],
      "$/*": ["src/services/*"]
    }
  },
  "include": ["vite.config.ts"]
}
